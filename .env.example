# Database (PostgreSQL). In a container, `localhost` is the container — a
# Postgres on the host is `host.docker.internal`.
DATABASE_URL=postgres://user:pass@localhost:5432/player_backend

# Where the server binds. Set HOST=127.0.0.1 when a reverse proxy is the only
# thing that should be able to reach the API. Ignored under compose; use
# PUBLISH_ADDR below.
HOST=0.0.0.0
PORT=3700

# Trust `X-Forwarded-For` when determining a caller's address. Only enable this
# behind a proxy you control — otherwise clients can forge the header and slip
# past the per-IP rate limits.
TRUST_PROXY=false

# Memory budget for the served-image cache, in bytes (default 128 MiB). Images
# are cached by content hash, so a hit serves them without touching the
# database at all. Set to 0 to always read them from the database.
IMAGE_CACHE_BYTES=134217728

# Discord webhook that notable events are mirrored to — server start and stop,
# 5xx responses, rate limiting, logins, and tracks added or removed. Leave it
# blank and nothing is ever sent. Anyone holding this URL can post to the
# channel, so treat it as a secret.
DISCORD_WEBHOOK_URL=

# Read by compose, not by the server: where the API's port is published.
# 0.0.0.0 to serve the network directly.
PUBLISH_ADDR=127.0.0.1

# Which published image to run. Pin it to a version to make rollback a one-line
# change.
VEX_TAG=latest
