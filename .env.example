# Database (PostgreSQL).
DATABASE_URL=postgres://user:pass@host:5432/vexwave

# Port to listen on.
PORT=3700

# Set to true when using a Proxy.
TRUST_PROXY=false

# Memory budget for the served-image cache, in bytes (default 128 MiB).
IMAGE_CACHE_BYTES=134217728

# Discord webhook for notifications.
DISCORD_WEBHOOK_URL=
