# Database (PostgreSQL)
DATABASE_URL=postgres://user:pass@localhost:5432/player_backend

# Where the server binds. Set HOST=127.0.0.1 when a reverse proxy is the only
# thing that should be able to reach the API.
HOST=0.0.0.0
PORT=3700

# Trust `X-Forwarded-For` when determining a caller's address. Only enable this
# behind a proxy you control — otherwise clients can forge the header and slip
# past the per-IP rate limits.
TRUST_PROXY=false
